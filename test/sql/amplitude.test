amplitude	Sign Up	user_42	12345	1794614700000	NULL
amplitude	Purchase	user_42	12345	1794615000000	19.99
amplitude	Purchase	user_7	777	1794615600000	15.0

query I
SELECT count(*) FROM read_json('{AMPLITUDE_FIXTURE_URL}/__requests?path=/api/2/export')
WHERE query = '{"end": "20261114T00", "start": "20261114T00"}';
----
1

