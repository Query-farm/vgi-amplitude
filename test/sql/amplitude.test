# ------------------------------------------------------------------ cohorts

query TTIT
SELECT id, name, size, created_at FROM amplitude.main.cohorts ORDER BY id;
----
coh_old	Old Trial	40	2023-07-22 04:26:40+00
coh_power	Power Buyers	12000	2025-01-01 00:00:00+00

query T
SELECT sync_metadata->0->>'target' FROM amplitude.main.cohorts WHERE id = 'coh_power';
----
braze

# Async export: request → poll (in progress, then completed) → 302 to a pre-signed link on
# another origin, fetched without credentials. 12,000 members = two batches.
query III
SELECT count(*), count(user_id), count(*) FILTER (WHERE properties = '{}') FROM amplitude.main.cohort_members('coh_power', poll_seconds := 1);
----
12000	11999	12000

query TIT
SELECT properties->>'gp:plan', count(*), min(user_id) FROM amplitude.main.cohort_members('coh_power', property_keys := ['plan'], poll_seconds := 1) GROUP BY ALL ORDER BY ALL;
----
free	8999	u1
pro	3001	u0

query I
SELECT count(*) FROM read_json('{AMPLITUDE_FIXTURE_URL}/__requests?path=/api/5/cohorts/request/coh_power') WHERE query LIKE '%"propKeys": "plan"%' AND query LIKE '%"props": "1"%';
----
1

statement error
SELECT count(*) FROM amplitude.main.cohort_members('missing', poll_seconds := 1);
----
<REGEX>:.*HTTP 404.*

