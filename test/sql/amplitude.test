# ------------------------------------------------------------------- funnel

query ITIRRR
SELECT step, event_type, users, conversion_rate, step_conversion_rate, median_seconds FROM amplitude.main.funnel(['Sign Up', 'Purchase', 'Page View'], DATE '2026-11-01', DATE '2026-11-07', mode := 'unordered', conversion_seconds := 86400) ORDER BY step;
----
1	Sign Up	1000	1.0	1.0	0.0
2	Purchase	500	0.5	0.5	60.0
3	Page View	250	0.25	0.5	120.0

query I
SELECT count(*) FROM read_json('{AMPLITUDE_FIXTURE_URL}/__requests?path=/api/2/funnels')
WHERE query LIKE '%"cs": "86400"%' AND query LIKE '%"mode": "unordered"%' AND query LIKE '%"n": "active"%';
----
1

