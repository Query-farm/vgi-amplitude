# scope = 'user' skips the per-event requests.
statement ok
SELECT count(*) FROM amplitude.unified.property_definitions WHERE scope = 'user';

query I
SELECT max(seq) < (SELECT max(seq) FROM read_json('{AMPLITUDE_FIXTURE_URL}/__requests?path=/api/2/taxonomy/user-property'))
FROM read_json('{AMPLITUDE_FIXTURE_URL}/__requests?path=/api/2/taxonomy/event-property');
----
true

# UNION ALL across tools works on the shared columns.
query TI
SELECT tool, count(*) FROM (
  SELECT tool, event_name, event_time FROM amplitude.unified.events
  WHERE received_time >= TIMESTAMPTZ '2026-11-14 04:00:00+00' AND received_time < TIMESTAMPTZ '2026-11-14 05:00:00+00'
  UNION ALL
  SELECT 'other' AS tool, 'Purchase' AS event_name, TIMESTAMPTZ '2026-11-14 04:00:00+00' AS event_time
) GROUP BY tool ORDER BY tool;
----
amplitude	2
other	1
