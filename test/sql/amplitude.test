# name: test/sql/amplitude.test
# description: SQL tests for the amplitude worker against the strict Amplitude replay server (test/mock_api/server.py)
# group: [amplitude]

require vgi

require-env AMPLITUDE_WORKER

require-env AMPLITUDE_FIXTURE_URL

# httpfs + json read the replay server's /__requests log to assert what was pushed down.
statement ok
LOAD httpfs;

statement ok
LOAD json;

statement ok
ATTACH 'amplitude' (TYPE vgi, LOCATION '{AMPLITUDE_WORKER}');

# ---------------------------------------------------------------- secret errors

statement error
SELECT count(*) FROM amplitude.main.cohorts;
----
<REGEX>:.*no amplitude secret.*

statement ok
CREATE SECRET amp_bad (TYPE amplitude, API_KEY 'test-api-key', SECRET_KEY 'wrong', BASE_URL '{AMPLITUDE_FIXTURE_URL}');

statement error
SELECT count(*) FROM amplitude.main.cohorts;
----
<REGEX>:.*HTTP 403.*Invalid API key.*

statement ok
DROP SECRET amp_bad;

statement ok
CREATE SECRET amp_half (TYPE amplitude, API_KEY 'test-api-key', BASE_URL '{AMPLITUDE_FIXTURE_URL}');

statement error
SELECT count(*) FROM amplitude.main.cohorts;
----
<REGEX>:.*SECRET_KEY are both required.*

statement ok
DROP SECRET amp_half;

statement ok
CREATE SECRET amp_insecure (TYPE amplitude, API_KEY 'k', SECRET_KEY 's', BASE_URL 'http://amplitude.com');

statement error
SELECT count(*) FROM amplitude.main.cohorts;
----
<REGEX>:.*https.*

statement ok
DROP SECRET amp_insecure;

statement ok
CREATE SECRET amp_region (TYPE amplitude, API_KEY 'k', SECRET_KEY 's', REGION 'mars');

statement error
SELECT count(*) FROM amplitude.main.cohorts;
----
<REGEX>:.*REGION must be 'us' or 'eu'.*

statement ok
DROP SECRET amp_region;

# Basic auth with the wrong secret key was recorded as auth=bad.
query I
SELECT count(*) > 0 FROM read_json('{AMPLITUDE_FIXTURE_URL}/__requests?path=/api/3/cohorts') WHERE auth = 'bad';
----
true

statement ok
CREATE SECRET amp (TYPE amplitude, API_KEY 'test-api-key', SECRET_KEY 'test-secret-key', BASE_URL '{AMPLITUDE_FIXTURE_URL}');

# Both keys are redacted in duckdb_secrets().
query I
SELECT secret_string NOT LIKE '%test-secret-key%' AND secret_string NOT LIKE '%test-api-key%' FROM duckdb_secrets() WHERE name = 'amp';
----
true

# ------------------------------------------------------------ events (Export API)

# One UTC day: the event_time range becomes upload hours [2026-11-13T23, ...]; the first
# 24-hour chunk is "too large" (the replay server's limit is 12 hours) and is halved.
query ITR
SELECT count(*), event_type, sum(revenue) FROM amplitude.main.events()
WHERE event_time >= TIMESTAMPTZ '2026-11-14 00:00:00+00' AND event_time < TIMESTAMPTZ '2026-11-15 00:00:00+00'
GROUP BY event_type ORDER BY event_type;
----
25001	Page View	NULL
5	Purchase	75.99
2	Sign Up	NULL

# The first Export API request was answered 429 and retried.
query I
SELECT count(*) >= 2 FROM read_json('{AMPLITUDE_FIXTURE_URL}/__requests?path=/api/2/export') r
WHERE query = (SELECT query FROM read_json('{AMPLITUDE_FIXTURE_URL}/__requests?path=/api/2/export') ORDER BY seq LIMIT 1);
----
true

# The window started one hour before the day (clock skew) and the 24-hour chunk was halved.
query II
SELECT count(*) FILTER (WHERE query = '{"end": "20261114T22", "start": "20261113T23"}') >= 1,
       count(*) FILTER (WHERE query = '{"end": "20261114T10", "start": "20261113T23"}') = 1
FROM read_json('{AMPLITUDE_FIXTURE_URL}/__requests?path=/api/2/export');
----
true	true

# Revenue: $revenue, else $price x $quantity (user_7's 5 x 3 = 15).
query TR
SELECT country, sum(revenue) FROM amplitude.main.events()
WHERE event_time >= TIMESTAMPTZ '2026-11-14 00:00:00+00' AND event_time < TIMESTAMPTZ '2026-11-15 00:00:00+00' AND event_type = 'Purchase'
GROUP BY country ORDER BY country;
----
Germany	25.0
United States	50.99

# A late upload: the 20:00 event was uploaded five hours later and is found through late_hours.
query TTT
SELECT user_id, event_time, server_upload_time FROM amplitude.main.events()
WHERE event_time >= TIMESTAMPTZ '2026-11-13 20:00:00+00' AND event_time < TIMESTAMPTZ '2026-11-13 21:00:00+00';
----
user_9	2026-11-13 20:00:00+00	2026-11-14 01:10:00+00

# late_hours := 0 reads only the same hours (404 = no export files) and misses it.
query I
SELECT count(*) FROM amplitude.main.events(late_hours := 0)
WHERE event_time >= TIMESTAMPTZ '2026-11-13 20:00:00+00' AND event_time < TIMESTAMPTZ '2026-11-13 21:00:00+00';
----
0

query I
SELECT count(*) FROM read_json('{AMPLITUDE_FIXTURE_URL}/__requests?path=/api/2/export')
WHERE query = '{"end": "20261113T20", "start": "20261113T19"}';
----
1

# server_upload_time maps to the export hours exactly: one request for one hour of
# 25,000 events (three files, three Arrow batches).
query II
SELECT count(*), count(DISTINCT user_id) FROM amplitude.main.events()
WHERE server_upload_time >= TIMESTAMPTZ '2026-11-14 03:00:00+00' AND server_upload_time < TIMESTAMPTZ '2026-11-14 04:00:00+00';
----
25000	100

query I
SELECT count(*) FROM read_json('{AMPLITUDE_FIXTURE_URL}/__requests?path=/api/2/export')
WHERE query = '{"end": "20261114T03", "start": "20261114T03"}';
----
1

# Microsecond precision, inclusive and exclusive bounds.
query II
SELECT count(*) FILTER (WHERE event_time <= TIMESTAMPTZ '2026-11-14 05:59:59.999999+00'),
       count(*) FILTER (WHERE event_time < TIMESTAMPTZ '2026-11-14 05:59:59.999999+00')
FROM amplitude.main.events()
WHERE server_upload_time >= TIMESTAMPTZ '2026-11-14 05:00:00+00' AND server_upload_time < TIMESTAMPTZ '2026-11-14 06:00:00+00';
----
1	0

# Typed columns: ids, session (-1 → NULL), JSON properties, insert id, timestamps.
query TTIITTT
SELECT event_type, user_id, amplitude_id, session_id, insert_id, event_properties->>'path', user_properties->>'plan'
FROM amplitude.main.events()
WHERE server_upload_time >= TIMESTAMPTZ '2026-11-14 01:00:00+00' AND server_upload_time < TIMESTAMPTZ '2026-11-14 02:00:00+00'
ORDER BY event_time;
----
Purchase	user_9	999	1794600000000	ins-7	NULL	pro
Purchase	user_7	777	1794619200000	ins-5	NULL	free
Page View	NULL	5555	NULL	ins-6	/pricing	free

# Projection: only the needed columns are built, the rest stay typed.
query TTT
SELECT typeof(event_time), typeof(event_properties), typeof(location_lat) FROM amplitude.main.events()
WHERE server_upload_time >= TIMESTAMPTZ '2026-11-14 05:00:00+00' AND server_upload_time < TIMESTAMPTZ '2026-11-14 06:00:00+00';
----
TIMESTAMP WITH TIME ZONE	JSON	DOUBLE

# A range with no export files at all (404) is zero rows, not an error.
query I
SELECT count(*) FROM amplitude.main.events()
WHERE server_upload_time >= TIMESTAMPTZ '2026-11-14 02:00:00+00' AND server_upload_time < TIMESTAMPTZ '2026-11-14 03:00:00+00';
----
0

# chunk_hours := 1 reads hour by hour (T04 and T05); the T05 event, uploaded at 05:59:59,
# is outside the exact bound.
query I
SELECT count(*) FROM amplitude.main.events(chunk_hours := 1)
WHERE server_upload_time >= TIMESTAMPTZ '2026-11-14 04:00:00+00' AND server_upload_time <= TIMESTAMPTZ '2026-11-14 05:30:00+00';
----
2

query I
SELECT count(*) FROM read_json('{AMPLITUDE_FIXTURE_URL}/__requests?path=/api/2/export')
WHERE query IN ('{"end": "20261114T04", "start": "20261114T04"}', '{"end": "20261114T05", "start": "20261114T05"}');
----
4

statement error
SELECT count(*) FROM amplitude.main.events(chunk_hours := 0);
----
<REGEX>:.*chunk_hours.*

